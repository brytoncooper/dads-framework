{
  "name": "@dads-fixture/kit-workbench",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "tsx watch assembly/main.ts",
    "start": "tsx assembly/main.ts",
    "migrate": "tsx assembly/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=node_modules/.dads/vitest-report.json",
    "verify": "npm run typecheck && npm test",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "dev:up": "node assembly/dev.mjs up",
    "dev:down": "node assembly/dev.mjs down",
    "dev:mail": "node assembly/dev.mjs mail",
    "dev:status": "node assembly/dev.mjs status",
    "dev:restart": "node assembly/dev.mjs restart",
    "start:api": "tsx assembly/main.ts",
    "examples:setup": "node examples/setup.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.26",
    "@better-auth/sso": "1.7.26",
