  "cases": [
    {
      "id": "direct-ts-import",
      "description": "A producer change crosses an export-star boundary without selecting the whole workspace fallback.",
      "operations": [
        {
          "kind": "write",
          "path": "packages/core/src/leaf.ts",
          "contents": "export const leaf = \"direct-change\";\nconsole.log(leaf);\n"
        }
      ],
      "requiredTaskIds": [
        "api:lint",
        "api:test",
        "api:typecheck",
        "core:lint",
        "core:test",
        "core:typecheck",
        "web:lint",
        "web:test",
        "web:typecheck"
      ],
      "fullFallbackPolicy": "forbidden",
      "classification": "breaking",
      "expectedChangedTaskIds": [
        "api:test",
        "core:lint",
        "core:test",
        "web:test"
      ]
    },
    {
      "id": "direct-named-importer",
      "description": "A changed direct named importer has one known owning task closure.",
      "operations": [
        {
          "kind": "write",
          "path": "apps/api/src/direct.ts",
          "contents": "import { leaf } from \"../../../packages/core/src/leaf.js\";\nexport const direct = `${leaf}-changed`;\n"
        }
      ],
      "requiredTaskIds": [
        "api:lint",
        "api:test",
        "api:typecheck",
        "core:lint",
        "core:test",
        "core:typecheck"
      ],
      "expectedSelectionTaskIds": [
        "api:lint",
        "api:test",
        "api:typecheck",
        "core:lint",
        "core:test",
        "core:typecheck"
      ],
      "fullFallbackPolicy": "forbidden",
      "classification": "breaking",
      "expectedChangedTaskIds": ["api:test"]
    },
