{
  "name": "@dads-framework/client",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./telemetry/core": {
      "types": "./dist/telemetry/core/index.d.ts",
      "default": "./dist/telemetry/core/index.js"
    },
    "./telemetry/testing": {
      "types": "./dist/telemetry/testing.d.ts",
      "default": "./dist/telemetry/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@dads-framework/core": "0.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@sentry/react": "^10.48.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/react": "^10.48.0",
    "@tanstack/react-query": "^5.90.0",
    "vitest": "~4.1.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/client"
  }
}
