{
  "name": "@dads-framework/toolbox",
  "version": "0.5.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dad": "./bin/dad.js",
    "dad-dev": "./bin/dad-dev.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/dev/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@dads-framework/access": "0.5.2",
    "@dads-framework/testing": "0.5.2",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/foundation/toolbox"
  },
  "publishConfig": {
    "access": "public"
  }
}
