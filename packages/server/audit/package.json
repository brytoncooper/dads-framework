{
  "name": "@dads-framework/audit",
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src/lib/database/migrations/*.migration.ts",
    "README.md"
  ],
  "dependencies": {
    "@dads-framework/core": "0.6.0",
    "@dads-framework/email": "0.6.0",
    "@dads-framework/http": "0.6.0",
    "@dads-framework/job-queue": "0.6.0",
    "@dads-framework/postgres": "0.6.0",
    "@dads-framework/spicedb-access": "0.6.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "node-pg-migrate": "^9.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.12",
    "vitest": "~4.1.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "VITEST_TIER=integration vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/audit"
  }
}
