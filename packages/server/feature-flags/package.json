{
  "name": "@dads-framework/feature-flags",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src/postgres/migrations/*.migration.ts",
    "README.md"
  ],
  "dependencies": {
    "@dads-framework/core": "0.4.0",
    "zod": "^4.4.3"
  },
  "dadsBindings": {
    "http": [
      "@dads-framework/access",
      "@dads-framework/http"
    ],
    "postgres": [
      "@dads-framework/postgres",
      "drizzle-orm",
      "node-pg-migrate"
    ],
    "react": [
      "react"
    ]
  },
  "peerDependencies": {
    "@dads-framework/access": "0.4.0",
    "@dads-framework/http": "0.4.0",
    "@dads-framework/postgres": "0.4.0",
    "drizzle-orm": "^0.45.2",
    "node-pg-migrate": "^9.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@dads-framework/access": {
      "optional": true
    },
    "@dads-framework/http": {
      "optional": true
    },
    "@dads-framework/postgres": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "node-pg-migrate": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dads-framework/access": "0.4.0",
    "@dads-framework/http": "0.4.0",
    "@dads-framework/postgres": "0.4.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "drizzle-orm": "^0.45.2",
    "jsdom": "~22.1.0",
    "node-pg-migrate": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "testcontainers": "^12.0.4",
    "vitest": "~4.1.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "VITEST_TIER=integration vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/feature-flags"
  }
}
