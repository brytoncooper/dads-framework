{
  "name": "@dads-framework/http",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./protocol-mounts": {
      "types": "./dist/protocol-mounts/index.d.ts",
      "default": "./dist/protocol-mounts/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@dads-framework/access": "0.1.0",
    "@dads-framework/audit-actor": "0.1.0",
    "@dads-framework/contract": "0.1.0",
    "@dads-framework/diagnostics": "0.1.0",
    "@dads-framework/errors": "0.1.0",
    "@dads-framework/request-work": "0.1.0",
    "@fastify/cors": "^11.3.0",
    "fastify": "5.10.0",
    "pino": "^10.3.1",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "vitest": "~4.1.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "VITEST_TIER=integration vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/http"
  }
}
