{
  "name": "@dads-framework/identity-better-auth",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./impersonation-store": {
      "types": "./dist/impersonation-store/index.d.ts",
      "default": "./dist/impersonation-store/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "VITEST_TIER=integration vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@better-auth/core": "1.7.26",
    "@better-auth/sso": "1.7.26",
    "@dads-framework/identity": "0.1.0",
    "better-auth": "1.7.26",
    "kysely": "0.28.17",
    "node-pg-migrate": "^9.0.0"
  },
  "devDependencies": {
    "@dads-framework/migrations": "0.1.0",
    "@dads-framework/postgres": "0.1.0",
    "@testcontainers/postgresql": "^12.0.4",
    "samlify": "2.15.1",
    "testcontainers": "^12.0.4",
    "vitest": "~4.1.0"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/identity-better-auth"
  }
