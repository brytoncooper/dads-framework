{
  "name": "@dads-framework/migrations",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./journal-status": {
      "types": "./dist/journal-status.d.ts",
      "default": "./dist/journal-status.js"
    }
  },
  "bin": {
    "dads-migrate": "./dist/bin/migrate.js",
    "dads-migrate-adopt": "./dist/bin/adopt-existing-schema.js",
    "dads-migrate-status": "./dist/bin/read-database-journal-status.js",
    "dads-migration-new": "./dist/bin/new-migration.js",
    "dads-migration-check": "./dist/bin/check-migration-compatibility.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@dads-framework/audit-actor": "0.3.0",
    "@dads-framework/postgres": "0.3.0",
    "jiti": "2.4.2",
    "node-pg-migrate": "^9.0.0",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/pg": "^8.20.0",
    "pg": "^8.21.0",
    "vitest": "~4.1.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "VITEST_TIER=integration vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/migrations"
  }
}
