{
  "name": "@dads-framework/postgres",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/deterministic-uuid": {
      "types": "./dist/testing/deterministic-uuid.d.ts",
      "default": "./dist/testing/deterministic-uuid.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./dist/migrations/index.js"
    },
    "./migrations/journal-status": {
      "types": "./dist/migrations/journal-status.d.ts",
      "default": "./dist/migrations/journal-status.js"
    }
  },
  "dadsConformance": {
    "capability": "PostgreSQL pool checkout and transaction isolation",
    "suite": "src/lib/postgres-pool-laws.ts",
    "law": "runPostgresPoolLaws",
    "runs": [
      {
        "test": "src/lib/postgres-connection-conformance.integration.test.ts",
        "provider": {
          "module": "pg",
          "name": "Pool"
        }
      },
      {
        "test": "src/lib/postgres-connection-conformance.integration.test.ts",
        "provider": {
          "module": "./attributed-pool.js",
          "name": "createAttributedPool"
        }
      }
    ]
  },
  "files": [
    "dist",
    "README.md",
    "migrations/README.md"
  ],
  "dependencies": {
    "@dads-framework/core": "0.4.0",
    "drizzle-orm": "^0.45.2",
    "jiti": "2.4.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.20.0",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "testcontainers": "^12.0.4"
  },
  "peerDependenciesMeta": {
    "@testcontainers/postgresql": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/pg": "^8.20.0",
    "testcontainers": "^12.0.4",
    "vitest": "~4.1.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "VITEST_TIER=integration vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/postgres"
  },
  "bin": {
    "dads-migrate": "./dist/migrations/bin/migrate.js",
    "dads-migrate-adopt": "./dist/migrations/bin/adopt-existing-schema.js",
    "dads-migrate-status": "./dist/migrations/bin/read-database-journal-status.js",
    "dads-migration-new": "./dist/migrations/bin/new-migration.js",
    "dads-migration-check": "./dist/migrations/bin/check-migration-compatibility.js"
  }
}
