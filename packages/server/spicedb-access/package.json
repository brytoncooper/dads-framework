{
  "name": "@dads-framework/spicedb-access",
  "version": "0.6.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dads-import-spicedb": "./bin/dads-import-spicedb.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./authz-journal": {
      "types": "./dist/authz-journal/index.d.ts",
      "default": "./dist/authz-journal/index.js"
    },
    "./migration": {
      "types": "./dist/migration/index.d.ts",
      "default": "./dist/migration/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@authzed/authzed-node": "^1.6.1",
    "@dads-framework/access": "0.6.2",
    "@dads-framework/core": "0.6.2",
    "@dads-framework/job-queue": "0.6.2",
    "@dads-framework/postgres": "0.6.2",
    "drizzle-orm": "^0.45.2",
    "jiti": "2.4.2",
    "node-pg-migrate": "^9.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "testcontainers": "^12.0.4"
  },
  "peerDependenciesMeta": {
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dads-framework/postgres-access": "0.6.2",
    "@dads-framework/sqlite-access": "0.6.2",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "testcontainers": "^12.0.4",
    "vitest": "~4.1.0"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "VITEST_TIER=integration vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/spicedb-access"
  }
}
