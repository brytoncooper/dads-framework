{
  "name": "@dads-framework/telemetry",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dadsConformance": {
    "capability": "Request attribution on spans",
    "suite": "src/request-trace-conformance.test-support.ts",
    "law": "registerRequestTraceConformance",
    "runs": [
      {
        "test": "src/request-trace-conformance.test.ts",
        "provider": {
          "module": "./request-trace-conformance.test-support.js",
          "name": "RecordedTrace"
        }
      },
      {
        "test": "src/request-trace-conformance.test.ts",
        "provider": {
          "module": "./request-trace-conformance.test-support.js",
          "name": "OpenTelemetryTrace"
        }
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./testing": {
      "types": "./dist/core/testing/index.d.ts",
      "default": "./dist/core/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace": "^2.11.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-proto": {
      "optional": true
    },
    "@opentelemetry/instrumentation": {
      "optional": true
    },
    "@opentelemetry/instrumentation-http": {
      "optional": true
    },
    "@opentelemetry/instrumentation-pg": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/sdk-trace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dads-framework/http": "0.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "pg": "^8.13.0",
    "vitest": "~4.1.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.tests.json --pretty false"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/server/telemetry"
  }
}
