    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dads-framework/audit": "0.1.0",
    "@dads-framework/feature-flags": "0.1.0",
    "@dads-framework/migrations": "0.1.0",
    "@dads-framework/postgres-access": "0.1.0",
    "vitest": "~4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
