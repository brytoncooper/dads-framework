{
  "name": "@dads-framework/testing",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dad-test": "./bin/dad-test.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "optionalDependencies": {
    "@dads-framework/testing-native-darwin-arm64": "0.1.0",
    "@dads-framework/testing-native-darwin-x64": "0.1.0",
    "@dads-framework/testing-native-linux-arm64-gnu": "0.1.0",
    "@dads-framework/testing-native-linux-x64-gnu": "0.1.0",
    "@dads-framework/testing-native-win32-x64": "0.1.0"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/testing/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
