{
  "name": "@dads-framework/testing",
  "version": "0.8.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dad-test": "./bin/dad-test.js",
    "dad-test-import-nx": "./bin/dad-test-import-nx.js",
    "dad-test-nx": "./bin/dad-test-nx.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dst": {
      "types": "./dist/dst/index.d.ts",
      "default": "./dist/dst/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild/index.d.ts",
      "default": "./dist/esbuild/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./nx": {
      "types": "./dist/nx/index.d.ts",
      "default": "./dist/nx/index.js"
    },
    "./path-aliases": {
      "types": "./dist/path-aliases/index.d.ts",
      "default": "./dist/path-aliases/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "dst/README.md",
    "nx/README.md"
  ],
  "scripts": {
    "prepublishOnly": "node ../../../scripts/verify-prepublish.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "optionalDependencies": {
    "@dads-framework/testing-native-darwin-arm64": "0.8.3",
    "@dads-framework/testing-native-darwin-x64": "0.8.3",
    "@dads-framework/testing-native-linux-arm64-gnu": "0.8.3",
    "@dads-framework/testing-native-linux-x64-gnu": "0.8.3",
    "@dads-framework/testing-native-win32-x64": "0.8.3"
  },
  "license": "MIT",
  "author": "Bryton Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brytoncooper/dads-framework.git",
    "directory": "packages/testing/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  }
}
