{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "fixtures/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ]
}
